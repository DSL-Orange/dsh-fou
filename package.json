{
  "name": "dsh-fou",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "A floating container layer over DSH: chat without leaving the page, travel between sessions, and open anything — a web page, a file, or a plugin's own UI — in one pane. · 浮游：DSH 之上的一层悬浮容器 —— 不离开当前位置，就能碰到别处。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSL-Orange/dsh-fou.git"
  },
  "homepage": "https://github.com/DSL-Orange/dsh-fou#readme",
  "bugs": {
    "url": "https://github.com/DSL-Orange/dsh-fou/issues"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "accept.html",
    "panels.html",
    "editor.html",
    "view.html",
    "desk.html",
    "settings.html",
    "room.html",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "docs/",
    "skill/"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-context-menu": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1 || ^0.2.0-rc.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
